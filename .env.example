# ========== 基础设施 ==========
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=n8n
# 丢了它，n8n 里所有加密凭据全部作废 —— 生成后请异地备份
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# 服务器公网 IP 或域名（用于生成 webhook 地址）
N8N_HOST=127.0.0.1

# ========== WF1 接收通路鉴权 ==========
# Agent 推送选题时必须带 X-Token 请求头；为空时 bootstrap.sh 会自动生成
WEBHOOK_TOKEN=

# ========== 模型 ==========
# 成文（精活）
DEEPSEEK_API_KEY=
# 事实核查（精活）
# 免费档默认 glm-4-flash（实测 5.x / 4.7 / 4.6 / 4.5 在余额为 0 时全部 429/1113）
# 充值后改成 glm-5.3 即可，改完跑一次 tools/seed_keys.sh 生效，无需重导工作流
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# ========== 飞书（可选）==========
# 本地/受限环境可整体跳过 WF1b，改为手动推送选题
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
